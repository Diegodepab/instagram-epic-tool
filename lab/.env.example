# Archivo de ejemplo para credenciales del entorno de laboratorio
# CÓPIA este archivo a '.env' e introduce tus datos reales.
# NO subas el archivo '.env' al repositorio (asegúrate de que esté en .gitignore)

# Credenciales de la cuenta TEMPORAL (Burner account)
IG_TEMP_USERNAME=tu_usuario_temporal_aqui
IG_TEMP_PASSWORD=tu_contraseña_temporal_aqui

# Cuenta a la que le quieres hacer el mapeo (por defecto)
IG_TARGET_ACCOUNT=

# Configuración de Proxy (Opcional pero muy recomendado para evitar bloqueos de IP)
# Formato: http://usuario:password@direccion_ip:puerto
# Si usas proxy sin autenticación: http://direccion_ip:puerto
# IG_PROXY=http://user:pass@127.0.0.1:8080
ENABLE_INSTAGRAPI_LAB=false

# Live Scan mantiene valores conservadores. Para una prueba local autorizada de
# dos cuentas puedes reducir el volumen conservando el mismo flujo. Carga este
# archivo con: docker compose --env-file lab/.env up --build
LIVE_SCAN_FOLLOWERS_LIMIT=200
LIVE_SCAN_FOLLOWING_LIMIT=200
LIVE_SCAN_PROFILE_PICS_LIMIT=50
LIVE_SCAN_COOLDOWN_SECONDS=120
